{
  "name": "roomie",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @roomie/api db:generate",
    "db:migrate": "pnpm --filter @roomie/api db:migrate",
    "catalog:import": "pnpm --filter @roomie/api catalog:import",
    "scrape": "uv run --project tools/scraper ikea-scrape",
    "models:process": "pnpm --filter @roomie/models process"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
