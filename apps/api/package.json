{
  "name": "@roomie/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "catalog:import": "tsx --env-file-if-exists=../../.env src/catalog/import.ts",
    "catalog:publish": "tsx --env-file-if-exists=../../.env src/catalog/publish-cli.ts",
    "catalog:check": "tsx --env-file-if-exists=../../.env src/catalog/check-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@roomie/schema": "workspace:*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
