# Supabase Postgres
DATA_BASE_PASSWORD=
# Supabase dashboard -> Connect -> Session pooler, with the password URL-encoded.
# Used by the API and `pnpm db:migrate`.
DATABASE_URL=

# File storage for the 3D models, over the S3 protocol (Supabase Storage). From the Supabase
# dashboard: Storage -> Settings -> S3 connection, for the endpoint, the region and an access
# key; the bucket stays private, and the API hands the browser signed links. Set all five, or
# leave them all empty to serve the models from this machine.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# Uploaded floor plan images go in a second private bucket on the same service (default: plans).
STORAGE_PLANS_BUCKET=

# The vision model that reads uploaded plans. With GEMINI_API_KEY set, Gemini reads them, else
# Claude with CLAUDE_API_KEY; PLAN_READER=gemini or claude picks one, and with neither key (or
# PLAN_READER=none) plans are traced by hand in the editor. A Gemini key from Google AI Studio; on
# its free tier Google may use what's sent to improve its products.
PLAN_READER=
GEMINI_API_KEY=
# One model, or several separated by commas, tried in order when one is busy or out of its daily
# quota (20 reads a day per model on the free tier). Default: gemini-3.8-flash,gemini-3.5-flash
GEMINI_MODEL=
# A Claude API key from the Claude Console (ANTHROPIC_API_KEY works too). Paid per read: about
# $0.01 with claude-haiku-5-5 and $0.50 with claude-opus-5-5 (see pnpm plans:eval).
CLAUDE_API_KEY=
# Default: claude-opus-5-5. How hard it thinks: low, medium (default), high, xhigh or max.
CLAUDE_MODEL=
CLAUDE_EFFORT=
# The Claude model that furnishes homes, on the same key: under a cent a home with
# claude-haiku-5-5 (default; its homes were rated as good as Opus's), $0.08–0.27 with
# claude-opus-5-5. Effort as above.
LAYOUT_MODEL=
LAYOUT_EFFORT=

# Sign-in (PLAN.md M6), needed only for the steps that call an LLM: reading a plan, furnishing,
# new pieces for a room. Set up once in the Supabase dashboard:
# - Authentication -> Sign In / Providers: Email on (it sends sign-in links), and Google, with an
#   OAuth client made in Google Cloud (its redirect URI is the callback URL Supabase shows).
# - Authentication -> URL Configuration: site URL http://localhost:5173, and the redirect URL
#   http://localhost:5173/** (the page a sign-in link goes back to).
# - Project Settings -> JWT Keys: JWT signing keys on (the default for new projects), so the
#   API can check sessions itself.
# The project's URL (Project Settings -> Data API), for the API to check sessions against.
SUPABASE_URL=
# The same URL and the project's publishable key (Project Settings -> API Keys), for the browser
# to sign in with. Both are public: only settings starting with VITE_ reach the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# AUTH=off lets anyone use the steps that call an LLM without signing in: for local development
# before sign-in is set up. The API won't start with it when NODE_ENV=production.
AUTH=
# What each account may spend on LLM calls a day, in US dollars (default 1), counted by calendar
# day in this time zone (default America/Vancouver).
DAILY_ALLOWANCE_USD=
ALLOWANCE_TIME_ZONE=

# Who may use the internal rating page, /admin/rate (PLAN.md M7): the emails they sign in with,
# separated by commas. With AUTH=off, everyone may.
ADMIN_EMAILS=
