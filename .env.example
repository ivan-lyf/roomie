# Supabase Postgres
DATA_BASE_PASSWORD=
# Supabase dashboard -> Connect -> Session pooler, with the password URL-encoded.
# Used by the API and `pnpm db:migrate`.
DATABASE_URL=

# File storage for the 3D models, over the S3 protocol (Supabase Storage). From the Supabase
# dashboard: Storage -> Settings -> S3 connection, for the endpoint, the region and an access
# key; the bucket stays private, and the API hands the browser signed links. Set all five, or
# leave them all empty to serve the models from this machine.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# Uploaded floor plan images go in a second private bucket on the same service (default: plans).
STORAGE_PLANS_BUCKET=

# The vision model that reads uploaded plans. With GEMINI_API_KEY set, Gemini reads them, else
# Claude with CLAUDE_API_KEY; PLAN_READER=gemini or claude picks one, and with neither key (or
# PLAN_READER=none) plans are traced by hand in the editor. A Gemini key from Google AI Studio; on
# its free tier Google may use what's sent to improve its products.
PLAN_READER=
GEMINI_API_KEY=
# One model, or several separated by commas, tried in order when one is busy or out of its daily
# quota (20 reads a day per model on the free tier). Default: gemini-3.8-flash,gemini-3.5-flash
GEMINI_MODEL=
# A Claude API key from the Claude Console (ANTHROPIC_API_KEY works too). Paid per read: about
# $0.01 with claude-haiku-5-5 and $0.50 with claude-opus-5-5 (see pnpm plans:eval).
CLAUDE_API_KEY=
# Default: claude-opus-5-5. How hard it thinks: low, medium (default), high, xhigh or max.
CLAUDE_MODEL=
CLAUDE_EFFORT=
